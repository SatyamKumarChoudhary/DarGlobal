# --- Required ---
# Get a key at https://openrouter.ai/keys. Never commit the real key.
OPENROUTER_API_KEY=sk-or-...

# Pick a live :free model with `make free-models`.
LLM_PRIMARY_MODEL=google/gemma-4-31b-it:free
LLM_FALLBACK_MODELS=["baidu/ernie-5.5-flash-preview:free","nvidia/nemotron-3.5-lightning:free","openrouter/free"]

# --- Deployment ---
APP_PUBLIC_URL=http://localhost:7860
ENVIRONMENT=dev
LOG_LEVEL=INFO
PORT=7860
