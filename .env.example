# --- Required ---
# Get a key at https://openrouter.ai/keys. Never commit the real key.
OPENROUTER_API_KEY=sk-or-...

# Pick a live :free model with `make free-models`.
LLM_PRIMARY_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_FALLBACK_MODELS=["deepseek/deepseek-chat-v3-0324:free","qwen/qwen3-235b-a22b:free","openrouter/free"]

# --- Deployment ---
APP_PUBLIC_URL=http://localhost:7860
ENVIRONMENT=dev
LOG_LEVEL=INFO
PORT=7860
